# XAI_API_KEY: Required for xAI Grok API calls.
# AI Studio automatically injects this at runtime from user secrets.
XAI_API_KEY="MY_XAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending real emails via Resend.
RESEND_API_KEY="re_..."

# ADMIN_NOTIFICATION_EMAIL: Optional admin email to receive login alerts alongside the user.
ADMIN_NOTIFICATION_EMAIL="souvikbbsr811@gmail.com"

# SUPABASE CONFIGURATION:
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Your Supabase Public Anonymous API Key (Project Settings -> API)
VITE_SUPABASE_ANON_KEY=""
