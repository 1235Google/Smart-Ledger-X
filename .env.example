# GROQ_API_KEY: Required for Aurex AI features.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending real emails via Resend.
RESEND_API_KEY="re_..."

# RESEND_FROM_EMAIL: Optional custom sender address (e.g. "SmartLedger <reports@yourdomain.com>").
RESEND_FROM_EMAIL=""

# SUPABASE CONFIGURATION:
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Your Supabase Public Anonymous API Key (Project Settings -> API)
VITE_SUPABASE_ANON_KEY=""

# FIREBASE CONFIGURATION (Overrides for Vercel or external hosting):
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
