{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "businessName": { "type": "string" },
        "mobile": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Ledger transaction entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "partyName": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "paymentMode": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "AppState": {
      "title": "AppState",
      "description": "User app configuration and state store",
      "type": "object",
      "properties": {
        "startingBalance": { "type": "number" },
        "isSetupComplete": { "type": "boolean" },
        "userProfile": { "$ref": "#/entities/UserProfile" }
      }
    },
    "BackupRecord": {
      "title": "BackupRecord",
      "description": "Metadata for an encrypted cloud backup snapshot",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string" },
        "size": { "type": "number" },
        "status": { "type": "string" },
        "version": { "type": "string" },
        "type": { "type": "string" },
        "checksumSha256": { "type": "string" },
        "encryptionIv": { "type": "string" },
        "itemCounts": { "type": "object" },
        "storagePath": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "fileName", "createdAt", "size", "status", "version", "type", "checksumSha256", "userId"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin users for SmartLedger Admin Panel",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["Owner", "Super Admin", "Admin", "Manager"] },
        "status": { "type": "string", "enum": ["Active", "Disabled"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" },
        "createdById": { "type": "string" },
        "createdByEmail": { "type": "string" }
      },
      "required": ["email", "role", "status", "createdAt"]
    },
    "AdminSecurityLog": {
      "title": "AdminSecurityLog",
      "description": "Audit security log for admin logins, logouts and access changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "uid": { "type": "string" },
        "ip": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "timestamp": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "email", "timestamp", "action"]
    },
    "LoginHistoryRecord": {
      "title": "LoginHistoryRecord",
      "description": "Audit record of user login session activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "deviceName": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "ip": { "type": "string" },
        "location": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["Success", "Failed", "Blocked"] },
        "method": { "type": "string", "enum": ["Google", "Email", "PIN", "Biometric", "Password"] },
        "userAgent": { "type": "string" }
      },
      "required": ["id", "userId", "timestamp", "status", "method"]
    },
    "UserDeviceRecord": {
      "title": "UserDeviceRecord",
      "description": "Active registered device for user multi-device session management",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "ip": { "type": "string" },
        "location": { "type": "string" },
        "lastActive": { "type": "string" },
        "createdAt": { "type": "string" },
        "isCurrent": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "userAgent": { "type": "string" }
      },
      "required": ["id", "userId", "deviceId", "lastActive", "status"]
    },
    "UserSecurityConfig": {
      "title": "UserSecurityConfig",
      "description": "Encrypted security preferences and PIN lock configuration",
      "type": "object",
      "properties": {
        "pinEnabled": { "type": "boolean" },
        "pin": { "type": "string" },
        "pinLength": { "type": "number" },
        "biometricEnabled": { "type": "boolean" },
        "faceUnlockEnabled": { "type": "boolean" },
        "autoLockTime": { "type": "number" },
        "inactivityTimeout": { "type": "number" },
        "autoLogoutEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "Bill": {
      "title": "Bill",
      "description": "User scheduled recurring or one-off bill reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string" },
        "category": { "type": "string" },
        "frequency": { "type": "string" },
        "isPaid": { "type": "boolean" },
        "paidAt": { "type": "string" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "amount", "dueDate", "category", "frequency", "isPaid", "userId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User activity, security and bill notification item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "read": { "type": "boolean" },
        "actionUrl": { "type": "string" },
        "actionLabel": { "type": "string" },
        "priority": { "type": "string" },
        "referenceId": { "type": "string" },
        "eventKey": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["userId", "type", "title", "message", "read"]
    },
    "NotificationSettings": {
      "title": "NotificationSettings",
      "description": "User notification preferences and email delivery toggles",
      "type": "object",
      "properties": {
        "duePayments": { "type": "boolean" },
        "upcomingBills": { "type": "boolean" },
        "backupAlerts": { "type": "boolean" },
        "securityAlerts": { "type": "boolean" },
        "dailySummary": { "type": "boolean" },
        "weeklyReport": { "type": "boolean" },
        "pushEnabled": { "type": "boolean" },
        "emailNotifications": { "type": "boolean" },
        "emailAddress": { "type": "string" },
        "emailToggles": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{uid}/profile": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{uid}/ledger/{entryId}": {
      "schema": "LedgerEntry",
      "description": "User ledger entries"
    },
    "/users/{uid}/transactions/{transactionId}": {
      "schema": "LedgerEntry",
      "description": "User transaction records"
    },
    "/users/{uid}/app/state": {
      "schema": "AppState",
      "description": "User state synchronization document"
    },
    "/users/{uid}/backups/{backupId}": {
      "schema": "BackupRecord",
      "description": "User backup metadata records"
    },
    "/users/{uid}/loginHistory/{historyId}": {
      "schema": "LoginHistoryRecord",
      "description": "User login activity history"
    },
    "/users/{uid}/devices/{deviceId}": {
      "schema": "UserDeviceRecord",
      "description": "User active devices"
    },
    "/users/{uid}/security/config": {
      "schema": "UserSecurityConfig",
      "description": "User security configuration"
    },
    "/users/{uid}/bills/{billId}": {
      "schema": "Bill",
      "description": "User bills and recurring payments"
    },
    "/users/{uid}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notification inbox"
    },
    "/users/{uid}/settings/notifications": {
      "schema": "NotificationSettings",
      "description": "User notification configuration preferences"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Global notification dispatch queue scoped to user"
    },
    "/adminUsers/{adminId}": {
      "schema": "AdminUser",
      "description": "SmartLedger Admin Users list and RBAC configuration"
    },
    "/adminSecurityLogs/{logId}": {
      "schema": "AdminSecurityLog",
      "description": "SmartLedger Admin audit logs"
    }
  }
}
