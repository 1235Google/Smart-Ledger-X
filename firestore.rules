rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL REUSABLE PRIMITIVES & IDENTITY HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Role-Based Access Control Helper (Admin verification via trusted server record or custom claims)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io'] ||
        request.auth.token.get('admin', false) == true || 
        request.auth.token.get('role', '') in ['Owner', 'Super Admin', 'Admin', 'Manager', 'admin', 'administrator', 'superadmin'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['Owner', 'Super Admin', 'Admin', 'Manager', 'admin', 'administrator', 'superadmin'] ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
         )) ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.get('status', 'Active') != 'Disabled' &&
         (
           get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.get('role', 'Admin') in ['Owner', 'Super Admin', 'Admin', 'Manager', 'admin', 'administrator', 'superadmin'] ||
           get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.get('isAdmin', false) == true
         ))
      );
    }

    // =========================================================================
    // SYSTEM AVAILABILITY & MAINTENANCE MODE ENFORCEMENT
    // =========================================================================

    function getSystemMode() {
      return exists(/databases/$(database)/documents/system/config)
        ? get(/databases/$(database)/documents/system/config).data.get('mode', 'normal')
        : 'normal';
    }

    // Normal users can read if system is not in maintenance; admins retain full access
    function isSystemReadAllowed() {
      return isAdmin() || getSystemMode() != 'maintenance';
    }

    // Normal users can write ONLY when system is in Normal mode; admins retain repair write access
    function isSystemWriteAllowed() {
      return isAdmin() || getSystemMode() == 'normal';
    }

    function isValidSystemConfig(data) {
      return data is map &&
        data.get('mode', 'normal') in ['normal', 'readonly', 'maintenance'] &&
        (!('reason' in data) || (data.reason is string && data.reason.size() <= 500)) &&
        (!('changedBy' in data) || (data.changedBy is string && data.changedBy.size() <= 150)) &&
        (!('autoRestore' in data) || (data.autoRestore is bool));
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS (EIGHT PILLARS OF HARDENED RULES)
    // =========================================================================

    function isValidUserProfile(data) {
      return data is map &&
        (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 120)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500000)) &&
        (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 150)) &&
        (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 30)) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
        (!('isAdmin' in data) || (data.isAdmin is bool));
    }

    function isValidLedgerEntry(data) {
      return data is map &&
        (!('amount' in data) || (data.amount is number && data.amount >= 0 && data.amount <= 1000000000)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 30)) &&
        (!('personName' in data) || (data.personName is string && data.personName.size() <= 150)) &&
        (!('purpose' in data) || (data.purpose is string && data.purpose.size() <= 300)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 60)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 60));
    }

    function isValidAppState(data) {
      return data is map &&
        (!('startingBalance' in data) || (data.startingBalance is number)) &&
        (!('isSetupComplete' in data) || (data.isSetupComplete is bool));
    }

    function isValidBackupRecord(data) {
      return data is map &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 200)) &&
        (!('size' in data) || (data.size is number && data.size >= 0)) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
        (!('version' in data) || (data.version is string && data.version.size() <= 30)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
        (!('checksumSha256' in data) || (data.checksumSha256 is string && data.checksumSha256.size() <= 128));
    }

    function isValidLoginHistoryRecord(data) {
      return data is map &&
        (!('userId' in data) || data.userId == request.auth.uid) &&
        (!('status' in data) || (data.status is string && data.status in ['Success', 'Failed', 'Blocked'])) &&
        (!('method' in data) || (data.method is string && data.method.size() <= 50)) &&
        (!('ip' in data) || (data.ip is string && data.ip.size() <= 100));
    }

    function isValidUserDeviceRecord(data) {
      return data is map &&
        (!('userId' in data) || data.userId == request.auth.uid) &&
        (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128)) &&
        (!('deviceName' in data) || (data.deviceName is string && data.deviceName.size() <= 150)) &&
        (!('status' in data) || (data.status is string && data.status in ['active', 'revoked']));
    }

    function isValidUserSecurityConfig(data) {
      return data is map &&
        (!('pinEnabled' in data) || (data.pinEnabled is bool)) &&
        (!('biometricEnabled' in data) || (data.biometricEnabled is bool)) &&
        (!('autoLockTime' in data) || (data.autoLockTime is number && data.autoLockTime >= 0));
    }

    function isValidBill(data) {
      return data is map &&
        (!('name' in data) || (data.name is string && data.name.size() <= 150)) &&
        (!('amount' in data) || (data.amount is number && data.amount >= 0)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 60)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
        (!('frequency' in data) || (data.frequency is string && data.frequency.size() <= 60)) &&
        (!('isPaid' in data) || (data.isPaid is bool)) &&
        (!('userId' in data) || (data.userId == request.auth.uid));
    }

    function isValidNotification(data) {
      return data is map &&
        (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
        (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 60)) &&
        (!('read' in data) || (data.read is bool));
    }

    function isValidAdminUser(data) {
      return data is map &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('role' in data) || (data.role is string && data.role in ['Owner', 'Super Admin', 'Admin', 'Manager', 'admin', 'administrator', 'superadmin'])) &&
        (!('status' in data) || (data.status is string && data.status in ['Active', 'Disabled']));
    }

    function isValidAdminSecurityLog(data) {
      return data is map &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('action' in data) || (data.action is string && data.action.size() <= 80)) &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 60));
    }

    // =========================================================================
    // DEFAULT DENY CATCH-ALL (FIRST PILLAR)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // SYSTEM CONFIGURATION & AVAILABILITY MODE
    // =========================================================================
    match /system/config {
      // Anyone (authenticated or unauthenticated) can read system mode to display status/maintenance UI
      allow read: if true;
      // ONLY verified administrators can modify system availability mode
      allow write: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      ) && isValidSystemConfig(incoming());
    }

    // =========================================================================
    // USER DOMAIN PARTITIONING (STRICT MASTER GATE)
    // =========================================================================

    // Root user document
    match /users/{userId} {
      allow read: if isOwner(userId) && isSystemReadAllowed();
      allow delete: if isOwner(userId) && isSystemWriteAllowed();
      allow create, update: if isOwner(userId) && isSystemWriteAllowed() && isValidUserProfile(incoming());
    }

    // User Profile subcollection
    match /users/{userId}/profile/{infoDoc} {
      allow read: if isOwner(userId) && isSystemReadAllowed();
      allow delete: if isOwner(userId) && isSystemWriteAllowed();
      allow create, update: if isOwner(userId) && isSystemWriteAllowed() && isValidUserProfile(incoming());
    }
    match /users/{userId}/profile {
      allow read: if isOwner(userId) && isSystemReadAllowed();
      allow delete: if isOwner(userId) && isSystemWriteAllowed();
      allow create, update: if isOwner(userId) && isSystemWriteAllowed() && isValidUserProfile(incoming());
    }

    // User Ledger transactions subcollection
    match /users/{userId}/ledger/{entryId} {
      allow get: if isOwner(userId) && isValidId(entryId) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(entryId) && isSystemWriteAllowed() && isValidLedgerEntry(incoming());
      allow delete: if isOwner(userId) && isValidId(entryId) && isSystemWriteAllowed();
    }

    // User Transactions duplicate index subcollection
    match /users/{userId}/transactions/{txId} {
      allow get: if isOwner(userId) && isValidId(txId) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(txId) && isSystemWriteAllowed() && isValidLedgerEntry(incoming());
      allow delete: if isOwner(userId) && isValidId(txId) && isSystemWriteAllowed();
    }

    // User App state subcollection
    match /users/{userId}/app/{stateDoc} {
      allow get: if isOwner(userId) && isValidId(stateDoc) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(stateDoc) && isSystemWriteAllowed() && isValidAppState(incoming());
      allow delete: if isOwner(userId) && isValidId(stateDoc) && isSystemWriteAllowed();
    }

    // User Encrypted Backups metadata subcollection
    match /users/{userId}/backups/{backupId} {
      allow get: if isOwner(userId) && isValidId(backupId) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(backupId) && (isSystemWriteAllowed() || isAdmin()) && isValidBackupRecord(incoming());
      allow delete: if isOwner(userId) && isValidId(backupId) && (isSystemWriteAllowed() || isAdmin());

      // Disaster recovery payload subcollection
      match /payload/{dataDoc} {
        allow read: if isOwner(userId) && isValidId(backupId) && isSystemReadAllowed();
        allow write: if isOwner(userId) && isValidId(backupId) && (isSystemWriteAllowed() || isAdmin());
      }
    }

    // User Backup health and synchronization status
    match /users/{userId}/backups_meta/{statusDoc} {
      allow read: if isOwner(userId) && isValidId(statusDoc) && isSystemReadAllowed();
      allow write: if isOwner(userId) && isValidId(statusDoc) && (isSystemWriteAllowed() || isAdmin());
    }

    // User Login History subcollection
    match /users/{userId}/loginHistory/{historyId} {
      allow get: if isOwner(userId) && isValidId(historyId) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create: if isOwner(userId) && isValidId(historyId) && isValidLoginHistoryRecord(incoming());
      allow delete: if isOwner(userId) && isValidId(historyId) && isSystemWriteAllowed();
    }

    // User Active Registered Devices subcollection
    match /users/{userId}/devices/{deviceId} {
      allow get: if isOwner(userId) && isValidId(deviceId) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(deviceId) && isSystemWriteAllowed() && isValidUserDeviceRecord(incoming());
      allow delete: if isOwner(userId) && isValidId(deviceId) && isSystemWriteAllowed();
    }

    // User Security preferences & PIN configuration
    match /users/{userId}/security/{configDoc} {
      allow get: if isOwner(userId) && isValidId(configDoc) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(configDoc) && isSystemWriteAllowed() && isValidUserSecurityConfig(incoming());
      allow delete: if isOwner(userId) && isValidId(configDoc) && isSystemWriteAllowed();
    }

    // User Bills and recurring reminders
    match /users/{userId}/bills/{billId} {
      allow get: if isOwner(userId) && isValidId(billId) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(billId) && isSystemWriteAllowed() && isValidBill(incoming());
      allow delete: if isOwner(userId) && isValidId(billId) && isSystemWriteAllowed();
    }

    // User Notification inbox subcollection
    match /users/{userId}/notifications/{notificationId} {
      allow get: if isOwner(userId) && isValidId(notificationId) && isSystemReadAllowed();
      allow list: if isOwner(userId) && isSystemReadAllowed();
      allow create, update: if isOwner(userId) && isValidId(notificationId) && isSystemWriteAllowed() && isValidNotification(incoming());
      allow delete: if isOwner(userId) && isValidId(notificationId) && isSystemWriteAllowed();
    }

    // User Notification settings subcollection
    match /users/{userId}/settings/{settingDoc} {
      allow read: if isOwner(userId) && isValidId(settingDoc) && isSystemReadAllowed();
      allow write: if isOwner(userId) && isValidId(settingDoc) && isSystemWriteAllowed();
    }

    // Fallback protection for any deeply nested user documents
    match /users/{userId}/{allSubPaths=**} {
      allow read: if isOwner(userId) && isSystemReadAllowed();
      allow write: if isOwner(userId) && isSystemWriteAllowed();
    }

    // =========================================================================
    // NOTIFICATIONS DISPATCH QUEUE (USER SCOPED)
    // =========================================================================
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && 
        (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow list: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && 
        (incoming().userId == request.auth.uid || incoming().userId == 'all');
      allow update: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && 
        (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow delete: if isSignedIn() && isValidId(notificationId) && 
        (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
    }

    // =========================================================================
    // ADMIN RBAC USERS & SECURITY AUDIT LOGS
    // =========================================================================
    match /adminUsers/{adminId} {
      allow read: if isSignedIn() && (
        request.auth.uid == adminId || 
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
      
      allow create: if isSignedIn() && isValidAdminUser(incoming()) && (
        isAdmin() || 
        request.auth.uid == adminId ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
      allow update: if isSignedIn() && isValidAdminUser(incoming()) && (
        isAdmin() || 
        request.auth.uid == adminId ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
    }

    match /adminSecurityLogs/{logId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
      // Append-only creation for authoritative audit events
      allow create: if isSignedIn() && isValidId(logId) && isValidAdminSecurityLog(incoming());
      // Tamper resistance: modifications and deletions are forbidden
      allow update, delete: if false;
    }

    // Direct client write to securityEvents is strictly denied (Requirement 12)
    match /securityEvents/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
      allow write: if false;
    }

    // Scheduled background job runs - Authoritative records generated by server
    match /scheduledJobRuns/{runId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
      // Direct client writes strictly forbidden - only trusted server environment writes
      allow write: if false;
    }

    // Scheduled background jobs configuration & toggles
    match /scheduledJobsConfig/{jobId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
      allow write: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
    }

    // Admin Reports Center scheduled subscriptions
    match /adminScheduledReports/{reportId} {
      allow read, write: if isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('email', '') in ['souvikbbsr811@gmail.com', 'souvikdashbbsr@gmail.com', 'admin@smartledgerx.io']
      );
    }
  }
}


