rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User root document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User Subcollections (Profile, Ledger, App State, Transactions, Backups, Login History, Devices, Security)
    match /users/{userId}/profile {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/ledger/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/transactions/{txId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/app/{stateDoc} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/backups/{backupId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/loginHistory/{historyId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/devices/{deviceId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/security/{configDoc} {
      allow read, write: if isOwner(userId);
    }

    // Fallback catch-all for any user subcollections
    match /users/{userId}/{allSubPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Admin Users Collection (RBAC & Whitelist Access Control)
    match /adminUsers/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Admin Security Audit Logs
    match /adminSecurityLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Notifications collection - strictly scoped to recipient or broadcast
    match /notifications/{notificationId} {
      allow create: if isSignedIn() && (
        !('userId' in request.resource.data) || 
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.userId == 'all'
      );
      allow read, update, delete: if isSignedIn() && (
        !('userId' in resource.data) || 
        resource.data.userId == request.auth.uid || 
        resource.data.userId == 'all'
      );
    }
  }
}


